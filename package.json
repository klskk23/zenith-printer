{
  "name": "zenith-printer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "node --env-file-if-exists=.env --experimental-strip-types packages/server/src/index.ts",
    "dev": "bash scripts/dev.sh",
    "typecheck": "tsc --build --force && tsc --noEmit -p packages/web",
    "lint": "eslint .",
    "test": "vitest run --project default --project web",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:hardware": "vitest run --project hardware",
    "fetch-fonts": "bash scripts/fetch-fonts.sh",
    "subset-fonts": "python3 scripts/subset-fonts.py",
    "cli": "node --experimental-strip-types packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "@serialport/bindings-cpp@12.0.1": true
  },
  "overrides": {
    "react-resize-detector": "^12"
  }
}
