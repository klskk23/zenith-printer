# Zenith Printer — deployment settings.
#
# Read by the systemd unit after its built-in defaults, so every line here
# wins. dpkg treats this file as configuration: your edits survive upgrades,
# and a changed file is offered to you rather than overwritten.
#
# Apply changes with:
#   sudo systemctl restart zenith-printer

# Where the service listens. 0.0.0.0 makes it reachable from the LAN — which
# it must be, and no further: there is no authentication, so anyone who can
# reach this port can print, and exposing it to the internet is a mistake
# rather than a configuration choice.
ZENITH_HOST=0.0.0.0
ZENITH_PORT=3000

# SQLite database and uploaded images. /var/lib/zenith-printer is created by
# the unit (StateDirectory=) and owned by the service user.
ZENITH_DB=/var/lib/zenith-printer/zenith.db
ZENITH_UPLOADS=/var/lib/zenith-printer/uploads

# error | warn | info | debug
LOG_LEVEL=info

# Run every motion except the printing itself. Useful for a demo, and for any
# check that must not consume stock.
# ZENITH_DRY_RUN=1

# ---------------------------------------------------------------------------
# Google Sheets data sources (optional)
# ---------------------------------------------------------------------------
# Path to a Google service-account key file. Unset turns the feature off
# entirely — the "link a Google Sheet" entry point does not appear at all.
#
# The key reads EVERY spreadsheet shared with its account, so lock the file
# down and share sheets with its client_email one at a time (Viewer is enough):
#
#   sudo install -o root -g zenith -m 0640 key.json /etc/zenith-printer/google.json
#
# ZENITH_GOOGLE_CREDENTIALS=/etc/zenith-printer/google.json
