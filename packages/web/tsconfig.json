{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // bwip-js publishes no default export condition — only browser, node,
    // electron and react-native. Vite resolves the browser build here, so the
    // type checker has to be told to resolve the same one, or @zenith/shared
    // fails to typecheck the moment the web package pulls it in.
    "customConditions": ["browser"],
    // The other half of the `@` alias vite.config.ts already had. Without it
    // the bundler resolves `@/components/ui/button` and the type checker does
    // not — which is exactly the state anything added by `shadcn add` would
    // arrive in, since that is the import style it writes.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
