#!/bin/sh
# Stop the service before its files go away — but only on removal, not on the
# unpack half of an upgrade, where postinst restarts it a moment later.
set -e

if [ -d /run/systemd/system ] && [ "$1" = remove ]; then
  deb-systemd-invoke stop zenith-printer.service >/dev/null || true
fi

exit 0
