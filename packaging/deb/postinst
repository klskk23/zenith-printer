#!/bin/sh
# Zenith Printer — post-installation.
#
# The systemd blocks follow the shape dh_installsystemd generates, so that
# enable/disable state set by the administrator survives an upgrade. Written
# out by hand because this package is assembled with dpkg-deb rather than
# debhelper (see packaging/README.md for why).
set -e

SERVICE=zenith-printer.service
SVC_USER=zenith
STATE_DIR=/var/lib/zenith-printer
ENV_FILE=/etc/zenith-printer/zenith-printer.env

case "$1" in
  configure)
    if ! getent group "$SVC_USER" >/dev/null; then
      addgroup --system "$SVC_USER"
    fi
    if ! getent passwd "$SVC_USER" >/dev/null; then
      adduser --system --ingroup "$SVC_USER" --home "$STATE_DIR" --no-create-home \
              --gecos "Zenith Printer label service" "$SVC_USER"
    fi

    # The unit's StateDirectory= would create this too, but only at start.
    # Creating it here means a failed first start leaves a diagnosable tree
    # rather than nothing at all.
    mkdir -p "$STATE_DIR"
    chown "$SVC_USER":"$SVC_USER" "$STATE_DIR"
    chmod 0750 "$STATE_DIR"

    # Not world-readable: this file names the Google key path, and on a host
    # where somebody sets ZENITH_GOOGLE_CREDENTIALS that path is worth as much
    # as the key itself.
    if [ -f "$ENV_FILE" ]; then
      chown root:"$SVC_USER" "$ENV_FILE"
      chmod 0640 "$ENV_FILE"
    fi
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || \
   [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
  if [ -x /usr/bin/deb-systemd-helper ]; then
    deb-systemd-helper unmask "$SERVICE" >/dev/null || true
    # was-enabled defaults to true, so a first installation enables the unit.
    if deb-systemd-helper --quiet was-enabled "$SERVICE"; then
      deb-systemd-helper enable "$SERVICE" >/dev/null || true
    else
      deb-systemd-helper update-state "$SERVICE" >/dev/null || true
    fi
  fi

  if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
    if [ -n "$2" ]; then
      deb-systemd-invoke restart "$SERVICE" >/dev/null || true
    else
      deb-systemd-invoke start "$SERVICE" >/dev/null || true
    fi
  fi
fi

if [ "$1" = "configure" ] && [ -z "$2" ]; then
  cat <<'NOTICE'

Zenith Printer is installed and running on port 3000.

  Settings:  /etc/zenith-printer/zenith-printer.env   (systemctl restart after editing)
  Data:      /var/lib/zenith-printer
  Logs:      journalctl -u zenith-printer

There is no authentication. Anyone who can reach port 3000 can print labels
and cancel other people's jobs. Keep it on a LAN or a VPN.

To reach a NIIMBOT over USB serial the service user must see /dev/ttyACM0;
the unit already asks for the dialout group, so a printer that answers to
another device node is the case worth checking.

NOTICE
fi

exit 0
