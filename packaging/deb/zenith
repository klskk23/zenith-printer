#!/bin/sh
# The zenith command line, as installed by the zenith-printer package.
#
# It talks to the running service over REST (--server, default
# http://localhost:3000) rather than opening the database, so a command and the
# web interface can never disagree about what a refresh or an import did.
#
# /usr/bin/node first, because that is what the package depends on and what the
# service itself runs; PATH second, so this still works for somebody whose Node
# came from nvm or a tarball. The unit file cannot do the same — ExecStart takes
# an absolute path — which is why the two differ.
set -eu

if [ -x /usr/bin/node ]; then
  NODE=/usr/bin/node
elif NODE="$(command -v node 2>/dev/null)"; then
  :
else
  echo "zenith: no node interpreter found" >&2
  echo "        why:  the command runs TypeScript sources directly" >&2
  echo "        next: sudo apt install nodejs   (26 or newer)" >&2
  exit 127
fi

exec "$NODE" --experimental-strip-types \
  /opt/zenith-printer/packages/cli/src/index.ts "$@"
