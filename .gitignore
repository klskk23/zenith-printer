# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest/

# Runtime data
*.db
*.db-journal
data/
uploads/

# Fonts (binaries fetched via scripts/fetch-fonts.sh; integrity pinned in fonts/MANIFEST.sha256)
fonts/full/*.ttf
fonts/full/*.otf
fonts/full/*.ttc
fonts/subset/*.ttf
fonts/subset/*.otf
fonts/subset/*.woff2

# Logs / env
*.log
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
data/
packages/web/public/fonts/

# Google service-account keys. A committed key reads every sheet shared with it,
# and a git history is forever — so the pattern is broad on purpose.
*service-account*.json
*google-credentials*.json
gcp-key*.json
